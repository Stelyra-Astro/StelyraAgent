{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stelyraagent.xiaoguiwk.com/schema/copy-catalog.schema.json",
  "title": "StelyraAgent reviewed consumer copy catalog v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contentVersion",
    "locale",
    "status",
    "contracts",
    "entries",
    "themeRulesByPreset"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "contentVersion": { "type": "string", "minLength": 1 },
    "locale": { "enum": ["en", "zh-Hans", "es", "fr"] },
    "status": { "enum": ["approved", "needs-fix"] },
    "contracts": {
      "type": "array",
      "minItems": 51,
      "maxItems": 51,
      "items": { "$ref": "#/$defs/cardContract" }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/copyEntry" }
    },
    "themeRulesByPreset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modern", "classical"],
      "properties": {
        "modern": {
          "type": "array",
          "items": { "$ref": "#/$defs/themeRule" }
        },
        "classical": {
          "type": "array",
          "items": { "$ref": "#/$defs/themeRule" }
        }
      }
    }
  },
  "$defs": {
    "cardContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "technique",
        "cardID",
        "selector",
        "facts",
        "evidenceByPreset",
        "textFields",
        "copySourceByPreset"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9.-]+$" },
        "technique": {
          "enum": ["natal", "current-sky", "transit", "secondary", "solar-return", "synastry", "today"]
        },
        "cardID": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "selector": { "type": "string", "pattern": "^[a-z0-9-]+\\.[a-z0-9-]+\\.v[0-9]+$" },
        "facts": {
          "type": "array",
          "minItems": 0,
          "items": { "type": "string", "pattern": "^[A-Za-z0-9.-]+$" },
          "uniqueItems": true
        },
        "evidenceByPreset": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[A-Za-z0-9.-]+$" },
            "uniqueItems": true
          },
          "propertyNames": { "enum": ["modern", "classical"] },
          "minProperties": 1
        },
        "textFields": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "copySourceByPreset": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "propertyNames": { "enum": ["modern", "classical"] },
          "minProperties": 1
        }
      }
    },
    "declaredVariable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$" },
        "type": {
          "enum": ["body", "sign", "house", "houseList", "aspect", "phase", "intensity", "percentage", "count", "date", "time", "duration", "personName"]
        }
      }
    },
    "copyEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "locale", "status", "kind", "sourcePath", "value", "variables"],
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "consumer" } }, "required": ["kind"] },
          "then": { "properties": { "variables": { "type": "array", "maxItems": 2 } } }
        }
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^copy\\.[a-z0-9.-]+$" },
        "locale": { "enum": ["en", "zh-Hans", "es", "fr"] },
        "status": { "enum": ["approved", "needs-fix"] },
        "kind": { "enum": ["consumer", "technical"] },
        "sourcePath": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 },
        "variables": {
          "type": "array",
          "maxItems": 3,
          "items": { "$ref": "#/$defs/declaredVariable" }
        }
      }
    },
    "themeRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "pair", "tone", "themeID"],
      "properties": {
        "id": { "type": "string", "pattern": "^theme-rule\\.[0-9]{3}$" },
        "pair": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "string", "pattern": "^[a-zA-Z0-9-]+$" }
        },
        "tone": { "enum": ["supportive", "challenging", "neutral"] },
        "themeID": { "type": "string", "pattern": "^[a-zA-Z0-9-]+\\.[a-zA-Z0-9-]+$" }
      }
    }
  }
}
