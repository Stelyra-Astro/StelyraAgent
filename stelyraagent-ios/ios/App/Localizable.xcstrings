    "profile.original-interpretations-translations-editorial-selection-and-arrangemen": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original interpretations, translations, editorial selection, and arrangement are separately copyrighted content and are not licensed under the AGPL merely because the application can load them."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原创解读、翻译、编辑选择与编排属于单独享有版权的内容；应用能够加载这些内容，不表示其自动依据 AGPL 授权。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las interpretaciones originales, las traducciones, la selección editorial y la organización son contenido protegido por derechos de autor de forma independiente y no se licencian bajo la AGPL por el mero hecho de que la aplicación pueda cargarlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les interprétations originales, traductions, choix éditoriaux et l’organisation sont des contenus protégés séparément par le droit d’auteur et ne sont pas placés sous licence AGPL du seul fait que l’application peut les charger."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özgün yorumlar, çeviriler, editoryal seçim ve düzenleme ayrı olarak telif hakkıyla korunur ve uygulamanın bunları yükleyebilmesi nedeniyle AGPL kapsamında lisanslanmış sayılmaz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Originaldeutungen, Übersetzungen, redaktionelle Auswahl und Anordnung sind eigenständig urheberrechtlich geschützt und werden nicht allein deshalb unter der AGPL lizenziert, weil die Anwendung sie laden kann."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le interpretazioni originali, le traduzioni, la selezione editoriale e l’organizzazione sono contenuti protetti separatamente da copyright e non sono concessi in licenza secondo AGPL solo perché l’applicazione può caricarli."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Original interpretations, translations, editorial selection, and arrangement are separately copyrighted content and are not licensed under the AGPL merely because the application can load them."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원문 해석, 번역, 편집 선택 및 배열은 별도의 저작권 보호 콘텐츠이며, 애플리케이션이 이를 불러올 수 있다는 이유만으로 AGPL에 따라 라이선스되는 것은 아닙니다."
          }
        }
      }
    },
