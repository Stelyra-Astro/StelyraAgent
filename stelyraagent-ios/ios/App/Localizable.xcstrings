    "insight.transit.this-module-shows-each-transiting-planets-sign-natal-house-direction-and": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This module shows each transiting planet's sign, natal house, direction and next calculated ingress or station."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里显示每颗行运行星的星座、本命宫位、运动方向，以及下一次已计算的换座、换宫或转向。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este módulo muestra el signo, la casa natal, la dirección y el próximo ingreso o estacionamiento calculado de cada planeta en tránsito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce module affiche, pour chaque planète en transit, son signe, sa maison natale, sa direction et sa prochaine entrée ou station calculée."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu modül her transit gezegeninin burcunu, doğum evini, yönünü ve hesaplanan bir sonraki burç girişi veya durağanlaşmasını gösterir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Modul zeigt für jeden Transitplaneten Zeichen, Radixhaus, Bewegungsrichtung und den nächsten berechneten Ingress oder Stationspunkt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo modulo mostra per ogni pianeta in transito il segno, la casa natale, la direzione e il prossimo ingresso o stazionamento calcolato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "This module shows each transiting planet's sign, natal house, direction and next calculated ingress or station."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 모듈은 각 트랜짓 행성의 별자리, 출생 하우스, 방향, 다음 계산된 진입 또는 정지 전환을 보여 줍니다."
          }
        }
      }
    },
