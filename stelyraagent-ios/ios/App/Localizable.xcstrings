    "insight.transit.planet-paths-shows-location-and-motion-active-transits-shows-exact-relat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Planet Paths shows location and motion. Active Transits shows exact relationships to natal planets and points."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "行星路径显示位置与运动；进行中的变化显示行运行星与本命星体或点位之间的精确关系。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trayectorias planetarias muestra la ubicación y el movimiento. Tránsitos activos muestra las relaciones exactas con planetas y puntos natales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trajectoires planétaires montre la position et le mouvement. Transits actifs montre les relations exactes avec les planètes et points natals."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gezegen Yolları konumu ve hareketi gösterir. Aktif Transitler doğum gezegenleri ve noktalarıyla kesin ilişkileri gösterir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Planetenpfade zeigen Position und Bewegung. Aktive Transite zeigen exakte Beziehungen zu Radixplaneten und -punkten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Percorsi planetari mostra posizione e movimento. Transiti attivi mostra le relazioni esatte con pianeti e punti natali."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Planet Paths shows location and motion. Active Transits shows exact relationships to natal planets and points."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "행성 경로는 위치와 운동을 보여 줍니다. 활성 트랜짓은 출생 행성 및 포인트와의 정확한 관계를 보여 줍니다."
          }
        }
      }
    },
