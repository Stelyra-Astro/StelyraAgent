          }
        }
      }
    },
    "commerce.delete-account-summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A new empty User ID is created after deletion. An active Apple subscription can be attached again with Restore Purchases."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除后会自动创建一个新的空账户。仍生效的 Apple 订阅可通过“恢复购买”重新关联。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras eliminarla se crea una cuenta nueva y vacía. Una suscripción de Apple activa puede volver a vincularse con Restaurar compras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nouveau compte vide est créé après la suppression. Un abonnement Apple actif peut être rattaché avec Restaurer les achats."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Silme işleminden sonra yeni ve boş bir User ID oluşturulur. Etkin bir Apple aboneliği Restore Purchases ile yeniden bağlanabilir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach dem Löschen wird eine neue leere User ID erstellt. Ein aktives Apple-Abonnement kann über „Käufe wiederherstellen“ erneut verknüpft werden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo l’eliminazione viene creato un nuovo User ID vuoto. Un abbonamento Apple attivo può essere ricollegato con Ripristina acquisti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A new empty User ID is created after deletion. An active Apple subscription can be attached again with Restore Purchases."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제 후 비어 있는 새 User ID가 생성됩니다. 활성 Apple 구독은 ‘구매 복원’으로 다시 연결할 수 있습니다."
          }
        }
      }
    },
    "commerce.delete-account-warning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently removes all Credits, profiles, people, saved reports, Ask history, and related settings from this account, device, and iCloud backup. Nothing can be recovered. Apple subscriptions are not cancelled; use Restore Purchases afterward to attach an active subscription to the new account."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将永久删除此账户、本机及 iCloud 备份中的所有 Credits、个人资料、人物、已保存报告、Ask 历史和相关设置，任何内容均无法恢复。Apple 订阅不会取消；删除后可使用“恢复购买”将仍生效的订阅关联到新账户。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina permanentemente todos los Credits, perfiles, personas, informes guardados, historial de Ask y ajustes relacionados de la cuenta, el dispositivo y la copia de iCloud. Nada puede recuperarse. Las suscripciones de Apple no se cancelan; usa Restaurar compras después para vincular una suscripción activa a la nueva cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action supprime définitivement tous les Credits, profils, personnes, rapports enregistrés, l’historique Ask et les réglages associés du compte, de l’appareil et de la sauvegarde iCloud. Rien ne pourra être récupéré. Les abonnements Apple ne sont pas annulés ; utilisez Restaurer les achats ensuite pour rattacher un abonnement actif au nouveau compte."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem bu hesap, cihaz ve iCloud yedeğindeki tüm Credit’leri, profilleri, kişileri, kayıtlı raporları, Ask geçmişini ve ilgili ayarları kalıcı olarak kaldırır. Hiçbir şey geri getirilemez. Apple abonelikleri iptal edilmez; etkin bir aboneliği yeni hesaba bağlamak için daha sonra Restore Purchases kullanın."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden alle Credits, Profile, Personen, gespeicherten Berichte, der Ask-Verlauf und zugehörige Einstellungen dauerhaft aus diesem Account, von diesem Gerät und aus dem iCloud-Backup entfernt. Nichts kann wiederhergestellt werden. Apple-Abonnements werden nicht gekündigt; verwende anschließend „Käufe wiederherstellen“, um ein aktives Abonnement mit dem neuen Account zu verknüpfen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa operazione rimuove definitivamente da questo account, dispositivo e backup iCloud tutti i Credit, i profili, le persone, i report salvati, la cronologia Ask e le relative impostazioni. Nulla può essere recuperato. Gli abbonamenti Apple non vengono annullati; usa poi Ripristina acquisti per collegare un abbonamento attivo al nuovo account."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently removes all Credits, profiles, people, saved reports, Ask history, and related settings from this account, device, and iCloud backup. Nothing can be recovered. Apple subscriptions are not cancelled; use Restore Purchases afterward to attach an active subscription to the new account."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업은 이 계정, 기기 및 iCloud 백업에서 모든 Credit, 프로필, 사람, 저장된 보고서, Ask 기록 및 관련 설정을 영구적으로 삭제합니다. 복구할 수 없습니다. Apple 구독은 취소되지 않으므로, 활성 구독을 새 계정에 연결하려면 이후 ‘구매 복원’을 사용하세요."
          }
        }
      }
    },
