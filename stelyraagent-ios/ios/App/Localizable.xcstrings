    "profile.feedback-uses-the-network-and-includes-the-app-version-and-device-model": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Feedback uses the network and includes the app version and device model, but never chart or birth data."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "反馈会联网并附带应用版本和设备型号，但不会附带星盘或出生资料。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los comentarios usan la red e incluyen la versión de la app y el modelo del dispositivo, pero nunca datos de cartas ni de nacimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les retours utilisent le réseau et incluent la version de l’app et le modèle de l’appareil, mais jamais les données de carte ou de naissance."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri bildirim ağı kullanır ve uygulama sürümü ile cihaz modelini içerir; ancak harita veya doğum verilerini asla içermez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Feedback nutzt das Netzwerk und enthält App-Version und Gerätemodell, aber niemals Horoskop- oder Geburtsdaten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il feedback usa la rete e include la versione dell’app e il modello del dispositivo, ma mai dati del tema o di nascita."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Feedback uses the network and includes the app version and device model, but never chart or birth data."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "피드백에는 네트워크가 사용되며 앱 버전과 기기 모델이 포함되지만 차트 또는 출생 데이터는 포함되지 않습니다."
          }
        }
      }
    },
    "profile.generated-interpretations-will-be-regenerated-next-time-you-open-them": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
