    "commerce.delete-account-complete-message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A new empty account is ready. Use Restore Purchases if this Apple Account still has an active subscription."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新的空账户已创建。如果此 Apple 账户仍有生效订阅，请使用“恢复购买”。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La nueva cuenta vacía está lista. Usa Restaurar compras si esta cuenta de Apple aún tiene una suscripción activa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nouveau compte vide est prêt. Utilisez Restaurer les achats si ce compte Apple possède encore un abonnement actif."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni ve boş bir hesap hazır. Bu Apple Account’ta hâlâ etkin bir abonelik varsa Restore Purchases kullanın."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein neuer leerer Account ist bereit. Verwende „Käufe wiederherstellen“, wenn dieser Apple Account noch ein aktives Abonnement hat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nuovo account vuoto è pronto. Usa Ripristina acquisti se questo Apple Account ha ancora un abbonamento attivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A new empty account is ready. Use Restore Purchases if this Apple Account still has an active subscription."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비어 있는 새 계정이 준비되었습니다. 이 Apple Account에 활성 구독이 남아 있다면 ‘구매 복원’을 사용하세요."
          }
        }
      }
    },
