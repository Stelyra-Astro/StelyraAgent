          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple이 구매를 확인했습니다. 계정 반영은 ‘새로고침’ 또는 다음 앱 실행 시 다시 시도됩니다."
          }
        }
      }
