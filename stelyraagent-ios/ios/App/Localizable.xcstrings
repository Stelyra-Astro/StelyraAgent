        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonelikler Apple hesap ayarlarından iptal edilmedikçe otomatik yenilenir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
