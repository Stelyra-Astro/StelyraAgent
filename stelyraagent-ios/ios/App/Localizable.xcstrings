    "profile.this-removes-all-saved-chart-reports-from-this-device": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes all saved chart reports from this device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会删除本机保存的全部星盘报告。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina de este dispositivo todos los informes de cartas guardados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime de cet appareil tous les rapports de cartes enregistrés."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem bu cihazdaki tüm kayıtlı harita raporlarını kaldırır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden alle gespeicherten Horoskopberichte von diesem Gerät entfernt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuove tutti i report dei temi salvati da questo dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes all saved chart reports from this device."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서 저장된 모든 차트 보고서를 삭제합니다."
          }
        }
      }
    },
    "profile.this-removes-locally-generated-chart-reports-linked-to-your-current-birt": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes locally generated chart reports linked to your current birth profile."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会删除与当前本人出生资料关联的本机生成报告。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina los informes de cartas generados localmente vinculados a tu perfil de nacimiento actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime les rapports de cartes générés localement et liés à votre profil de naissance actuel."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem mevcut doğum profilinizle bağlantılı, yerel olarak oluşturulmuş harita raporlarını kaldırır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden lokal erzeugte Horoskopberichte entfernt, die mit deinem aktuellen Geburtsprofil verknüpft sind."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuove i report dei temi generati localmente e collegati al tuo profilo di nascita attuale."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes locally generated chart reports linked to your current birth profile."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 출생 프로필과 연결된 로컬 생성 차트 보고서를 삭제합니다."
          }
        }
      }
    },
