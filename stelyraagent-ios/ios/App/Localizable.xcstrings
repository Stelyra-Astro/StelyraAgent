    "onboarding.plans-message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free includes 2 report Credits each calendar month. Pro keeps them, unlocks the complete interpretation layer and adds 10 extra Pro Credits each month."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Free 每个自然月包含 2 个报告 Credits。Pro 保留这 2 个免费 Credits，解锁全部深度解读，并每月额外增加 10 个 Pro Credits。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Free incluye 2 Credits de informe por mes natural. Pro los conserva, desbloquea toda la capa de interpretación y añade 10 Credits Pro extra cada mes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Free inclut 2 Credits de rapport par mois civil. Pro les conserve, débloque toute la couche d’interprétation et ajoute 10 Credits Pro supplémentaires chaque mois."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Free her takvim ayında 2 rapor Credit’i içerir. Pro bunları korur, tüm yorumlama katmanının kilidini açar ve her ay 10 ek Pro Credit ekler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Free enthält jeden Kalendermonat 2 Bericht-Credits. Pro behält sie bei, schaltet die vollständige Deutungsebene frei und fügt jeden Monat 10 zusätzliche Pro Credits hinzu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Free include 2 Credit per report ogni mese di calendario. Pro li mantiene, sblocca l’intero livello interpretativo e aggiunge 10 Pro Credit extra ogni mese."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Free includes 2 report Credits each calendar month. Pro keeps them, unlocks the complete interpretation layer and adds 10 extra Pro Credits each month."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Free에는 매월 보고서 Credit 2개가 포함됩니다. Pro는 이를 유지하면서 전체 해석 레이어를 잠금 해제하고 매월 Pro Credit 10개를 추가합니다."
          }
        }
      }
    },
