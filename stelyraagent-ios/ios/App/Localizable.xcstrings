          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Subscriptions renew automatically unless cancelled in your Apple account settings."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구독은 Apple Account 설정에서 취소하지 않는 한 자동 갱신됩니다."
