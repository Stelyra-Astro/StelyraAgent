    "insight.transit.timing-orb-house-and-motion-are-calculated-for-the-selected-chart-moment": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Timing, orb, house and motion are calculated for the selected chart moment and time zone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时间、容许度、宫位和运动状态均按当前选择的星盘时刻与时区计算。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La hora, el orbe, la casa y el movimiento se calculan para el momento y la zona horaria seleccionados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’heure, l’orbe, la maison et le mouvement sont calculés pour le moment et le fuseau horaire sélectionnés."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamanlama, orb, ev ve hareket seçilen harita anı ve saat dilimi için hesaplanır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Timing, Orb, Haus und Bewegung werden für den ausgewählten Horoskopzeitpunkt und die Zeitzone berechnet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempistica, orb, casa e movimento sono calcolati per il momento del tema e il fuso orario selezionati."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Timing, orb, house and motion are calculated for the selected chart moment and time zone."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "타이밍, 오브, 하우스, 운동은 선택한 차트 시각과 시간대를 기준으로 계산됩니다."
          }
        }
      }
    },
