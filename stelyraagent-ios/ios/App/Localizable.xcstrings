    "premium.preview-message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first insight is free. Pro unlocks every remaining interpretation card."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第一张解读卡免费预览，Pro 可解锁其余全部解读卡。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El primer análisis es gratuito. Pro desbloquea todas las demás tarjetas de interpretación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La première analyse est gratuite. Pro déverrouille toutes les autres cartes d’interprétation."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk içgörü ücretsizdir. Pro, kalan tüm yorum kartlarının kilidini açar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der erste Einblick ist kostenlos. Pro schaltet alle übrigen Deutungskarten frei."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il primo insight è gratuito. Pro sblocca tutte le schede interpretative rimanenti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "The first insight is free. Pro unlocks every remaining interpretation card."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 번째 인사이트는 무료입니다. Pro는 나머지 모든 해석 카드를 잠금 해제합니다."
          }
        }
      }
    },
