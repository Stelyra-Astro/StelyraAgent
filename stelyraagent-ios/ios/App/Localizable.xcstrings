        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo no puede verificar la instalación de la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil ne peut pas vérifier l’installation de l’app."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihaz uygulama kurulumunu doğrulayamıyor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät kann die App-Installation nicht überprüfen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo dispositivo non può verificare l’installazione dell’app."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "This device cannot verify the app installation."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서는 앱 설치를 확인할 수 없습니다."
          }
        }
      }
    },
