    "insight.synastry.saturn-jupiter-and-angle-contacts-show-reliability-growth-and-structural": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saturn, Jupiter and angle contacts show reliability, growth and structural pressure."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "土星、木星与角点联系显示可靠性、成长空间与结构压力。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los contactos de Saturno, Júpiter y los ángulos muestran fiabilidad, crecimiento y presión estructural."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les contacts de Saturne, Jupiter et des angles montrent la fiabilité, le potentiel de croissance et la pression structurelle."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satürn, Jüpiter ve açı noktası temasları güvenilirliği, gelişimi ve yapısal baskıyı gösterir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Saturn-, Jupiter- und Achsenkontakte zeigen Verlässlichkeit, Wachstum und strukturellen Druck."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I contatti di Saturno, Giove e degli angoli mostrano affidabilità, crescita e pressione strutturale."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Saturn, Jupiter and angle contacts show reliability, growth and structural pressure."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "토성, 목성, 각점 접촉은 신뢰성, 성장, 구조적 압력을 보여 줍니다."
          }
        }
      }
    },
