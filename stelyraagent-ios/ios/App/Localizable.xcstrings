    "app.error.local-chart-calculation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local chart calculation failed. Check the birth data and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地星盘计算失败，请检查出生资料后重试。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cálculo local de la carta falló. Comprueba los datos de nacimiento e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le calcul local de la carte a échoué. Vérifiez les données de naissance et réessayez."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel harita hesaplaması başarısız oldu. Doğum bilgilerini kontrol edip tekrar deneyin."
          }
        },
        "de": {
