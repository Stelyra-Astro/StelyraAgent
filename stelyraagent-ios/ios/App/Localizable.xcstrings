    "premium.pro-description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your 2 free monthly Credits. Pro unlocks every interpretation card, advanced controls, unlimited people and adds 10 extra Pro Credits each month."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留每月 2 个免费 Credits。Pro 解锁全部解读卡、高级控制和不限人物，并每月额外增加 10 个 Pro Credits。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva tus 2 Credits gratuitos al mes. Pro desbloquea todas las interpretaciones, controles avanzados, personas ilimitadas y añade 10 Credits Pro extra cada mes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservez vos 2 Credits gratuits mensuels. Pro débloque toutes les interprétations, les réglages avancés, les profils illimités et ajoute 10 Credits Pro supplémentaires chaque mois."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aylık 2 ücretsiz Credit’inizi koruyun. Pro tüm yorum kartlarının, gelişmiş kontrollerin ve sınırsız kişinin kilidini açar ve her ay 10 ek Pro Credit verir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behalte deine 2 kostenlosen monatlichen Credits. Pro schaltet jede Deutungskarte, erweiterte Steuerungen und unbegrenzt viele Personen frei und fügt jeden Monat 10 zusätzliche Pro Credits hinzu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni i tuoi 2 Credit gratuiti mensili. Pro sblocca tutte le schede interpretative, i controlli avanzati e persone illimitate, e aggiunge 10 Pro Credit extra ogni mese."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your 2 free monthly Credits. Pro unlocks every interpretation card, advanced controls, unlimited people and adds 10 extra Pro Credits each month."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매월 무료 Credit 2개는 그대로 유지됩니다. Pro는 모든 해석 카드, 고급 제어, 사람 무제한 저장을 잠금 해제하고 매월 Pro Credit 10개를 추가합니다."
          }
        }
      }
    },
    "premium.renewal-note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subscriptions renew automatically unless cancelled in your Apple account settings."
