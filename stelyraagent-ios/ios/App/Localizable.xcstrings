    "reports.richer-calculated-details": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A report works with richer calculated details for the selected chart—including planet positions, houses and angles, aspects, orbs and strength, motion and timing, plus Modern or Classical assessments where available."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "报告会根据所选盘型结合更丰富的计算细节，包括星体位置、宫位与四轴、相位及其容许度和强度、运行状态与时间信息，以及适用的现代或古典评估。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El informe utiliza más detalles calculados de la carta elegida: posiciones planetarias, casas y ángulos, aspectos, orbes e intensidad, movimiento y tiempos, además de evaluaciones modernas o clásicas cuando estén disponibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le rapport s’appuie sur davantage de détails calculés pour le thème choisi : positions planétaires, maisons et angles, aspects, orbes et intensité, mouvements et temporalité, ainsi que les évaluations modernes ou classiques disponibles."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapor, seçilen harita için gezegen konumları, evler ve açılar, açılar arası ilişkiler, orb ve güç, hareket ve zamanlama ile mevcut olduğunda Modern veya Klasik değerlendirmeler dahil daha zengin hesaplanmış ayrıntıları kullanır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Bericht nutzt umfangreichere berechnete Details für das ausgewählte Horoskop – darunter Planetenpositionen, Häuser und Achsen, Aspekte, Orben und Stärke, Bewegung und Timing sowie, sofern verfügbar, moderne oder klassische Bewertungen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un report utilizza dettagli calcolati più ricchi per il tema selezionato, incluse posizioni planetarie, case e angoli, aspetti, orbite e intensità, movimento e tempistiche, oltre a valutazioni Moderne o Classiche quando disponibili."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A report works with richer calculated details for the selected chart—including planet positions, houses and angles, aspects, orbs and strength, motion and timing, plus Modern or Classical assessments where available."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보고서는 선택한 차트의 더 풍부한 계산 세부 정보—행성 위치, 하우스와 각점, 애스펙트, 오브와 강도, 운동과 타이밍, 제공되는 경우 현대식 또는 고전식 평가—를 사용합니다."
          }
        }
      }
    },
