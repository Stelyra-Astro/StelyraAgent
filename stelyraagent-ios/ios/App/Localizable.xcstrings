    "ask.likelihood-and-suitability-describe-support-within-this-chart-model-they": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Likelihood and suitability describe support within this chart model. They are not statistical probabilities."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可能性和适合度表示当前盘面模型中的支持程度，并非统计学概率。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La probabilidad y la idoneidad describen el grado de apoyo dentro de este modelo de carta. No son probabilidades estadísticas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La probabilité et l’adéquation décrivent le degré de soutien dans ce modèle de carte. Ce ne sont pas des probabilités statistiques."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Olasılık ve uygunluk, bu harita modeli içindeki desteği açıklar. İstatistiksel olasılıklar değildir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wahrscheinlichkeit und Eignung beschreiben die Unterstützung innerhalb dieses Horoskopmodells. Sie sind keine statistischen Wahrscheinlichkeiten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Probabilità e idoneità descrivono il sostegno all’interno di questo modello astrologico. Non sono probabilità statistiche."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Likelihood and suitability describe support within this chart model. They are not statistical probabilities."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가능성과 적합성은 이 차트 모델 안에서의 지지 정도를 설명하며 통계적 확률이 아닙니다."
          }
        }
      }
    },
