        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生成的报告未能通过校验，请重试。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo verificar el informe generado. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le rapport généré n’a pas pu être vérifié. Réessayez."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oluşturulan rapor doğrulanamadı. Tekrar deneyin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der erzeugte Bericht konnte nicht verifiziert werden. Versuche es erneut."
