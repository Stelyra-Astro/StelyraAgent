          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sauvegarde les profils, rapports, la langue, l’apparence et les réglages d’interprétation dans votre conteneur iCloud privé."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profilleri, raporları, dili, görünümü ve yorumlama ayarlarını özel iCloud kapsayıcınıza yedekler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
