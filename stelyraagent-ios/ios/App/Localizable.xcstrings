    "insight.synastry.venus-and-mars-contacts-describe-attraction-and-pursuit-other-major-cont": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Venus and Mars contacts describe attraction and pursuit; other major contacts can add intensity."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "金星与火星联系描述吸引和追求，其他重要联系会增加强度。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los contactos de Venus y Marte describen la atracción y la iniciativa; otros contactos importantes pueden añadir intensidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les contacts de Vénus et Mars décrivent l’attraction et l’élan ; d’autres contacts majeurs peuvent ajouter de l’intensité."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Venüs ve Mars temasları çekimi ve yönelmeyi anlatır; diğer majör temaslar yoğunluk katabilir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Venus- und Marskontakte beschreiben Anziehung und Annäherung; andere Hauptkontakte können zusätzliche Intensität bringen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I contatti di Venere e Marte descrivono attrazione e inseguimento; altri contatti maggiori possono aggiungere intensità."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Venus and Mars contacts describe attraction and pursuit; other major contacts can add intensity."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "금성과 화성의 접촉은 끌림과 추구 방식을 설명하며, 다른 주요 접촉은 강도를 더할 수 있습니다."
          }
        }
      }
    },
