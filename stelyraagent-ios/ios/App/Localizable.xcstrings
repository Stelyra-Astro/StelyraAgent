    "insight.synastry.this-detail-uses-only-the-calculated-evidence-selected-for-this-card": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This detail uses only the calculated evidence selected for this card."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本详情只使用这张卡片已选中的计算证据。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este detalle utiliza únicamente la evidencia calculada seleccionada para esta tarjeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce détail utilise uniquement les éléments calculés sélectionnés pour cette carte."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ayrıntı yalnızca bu kart için seçilen hesaplanmış kanıtları kullanır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Detail verwendet nur die für diese Karte ausgewählten berechneten Belege."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo dettaglio usa solo le evidenze calcolate selezionate per questa scheda."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "This detail uses only the calculated evidence selected for this card."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 세부 내용은 이 카드에 선택된 계산 근거만 사용합니다."
          }
        }
      }
    },
    "insight.synastry.this-overview-separates-relationship-functions-because-the-same-connecti": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This overview separates relationship functions because the same connection can flow easily in one area and require adjustment in another."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这张总览会分别呈现不同关系功能，因为同一段连接可能在一个领域自然顺畅，在另一个领域需要磨合。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este resumen separa las funciones de la relación porque una misma conexión puede fluir con facilidad en un área y requerir ajustes en otra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette vue d’ensemble distingue les fonctions de la relation, car un même lien peut être fluide dans un domaine et demander des ajustements dans un autre."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu genel bakış ilişki işlevlerini ayırır; çünkü aynı bağlantı bir alanda kolay akarken başka bir alanda ayarlama gerektirebilir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Übersicht trennt Beziehungsfunktionen, weil dieselbe Verbindung in einem Bereich leicht fließen und in einem anderen Anpassung erfordern kann."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa panoramica separa le funzioni della relazione perché la stessa connessione può fluire facilmente in un’area e richiedere adattamento in un’altra."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "This overview separates relationship functions because the same connection can flow easily in one area and require adjustment in another."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 개요는 같은 연결이 한 영역에서는 자연스럽게 흐르고 다른 영역에서는 조정이 필요할 수 있으므로 관계 기능을 나누어 보여 줍니다."
          }
        }
      }
    },
