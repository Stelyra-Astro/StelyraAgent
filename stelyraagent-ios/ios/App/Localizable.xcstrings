        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是一条跨盘联系，显示一方行星如何触及另一方的本命结构。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un contacto entre cartas que muestra cómo el planeta de una persona se encuentra con el patrón natal de la otra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un contact entre deux cartes montrant comment la planète d’une personne rencontre le schéma natal de l’autre."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kişinin gezegeninin diğer kişinin doğum örüntüsüyle nasıl buluştuğunu gösteren haritalar arası bir temas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein horoskopübergreifender Kontakt, der zeigt, wie der Planet einer Person auf das Radixmuster der anderen trifft."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un contatto tra due temi che mostra come il pianeta di una persona incontra lo schema natale dell’altra."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cross-chart contact showing how one person’s planet meets the other person’s natal pattern."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 사람의 행성이 다른 사람의 출생 패턴과 어떻게 만나는지 보여 주는 차트 간 접촉입니다."
          }
        }
      }
    },
