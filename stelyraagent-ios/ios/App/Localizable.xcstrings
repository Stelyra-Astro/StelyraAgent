    "insight.transit.a-planet-can-matter-because-of-the-house-it-occupies-even-when-no-exact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A planet can matter because of the house it occupies even when no exact natal aspect is active."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使没有正在生效的精确本命相位，行星也会因所处宫位而具有明确的领域重点。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un planeta puede ser importante por la casa que ocupa incluso cuando no hay ningún aspecto natal exacto activo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une planète peut compter en raison de la maison qu’elle occupe, même lorsqu’aucun aspect natal exact n’est actif."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir gezegen, kesin bir doğum açısı aktif olmasa bile bulunduğu ev nedeniyle önemli olabilir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Planet kann aufgrund des Hauses, in dem er steht, bedeutsam sein, auch wenn kein exakter Radixaspekt aktiv ist."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pianeta può essere importante per la casa che occupa anche quando non è attivo alcun aspetto natale esatto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A planet can matter because of the house it occupies even when no exact natal aspect is active."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정확한 출생 애스펙트가 활성화되지 않아도 행성이 위치한 하우스 때문에 중요할 수 있습니다."
          }
        }
      }
    },
