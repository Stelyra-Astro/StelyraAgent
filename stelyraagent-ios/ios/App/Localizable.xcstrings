          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esegue il backup di profili, report, lingua, aspetto e impostazioni di interpretazione nel tuo contenitore iCloud privato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Backs up profiles, reports, language, appearance and interpretation settings to your private iCloud container."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로필, 보고서, 언어, 화면 모드 및 해석 설정을 개인 iCloud 컨테이너에 백업합니다."
