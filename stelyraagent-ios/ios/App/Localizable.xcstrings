{
  "sourceLanguage": "en",
  "strings": {
    "ai.app-verification-failed-http": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App verification failed (HTTP {{statusCode}})."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 验证失败（HTTP {{statusCode}}）。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La verificación de la app falló (HTTP {{statusCode}})."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vérification de l’app a échoué (HTTP {{statusCode}})."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama doğrulaması başarısız oldu (HTTP {{statusCode}})."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "App-Überprüfung fehlgeschlagen (HTTP {{statusCode}})."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica dell’app non riuscita (HTTP {{statusCode}})."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "App verification failed (HTTP {{statusCode}})."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 확인에 실패했습니다(HTTP {{statusCode}})."
          }
        }
      }
    },
    "ai.app-verification-invalid-response": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invalid response from the app verification service."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 验证服务返回了无效响应。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Respuesta no válida del servicio de verificación de la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réponse non valide du service de vérification de l’app."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama doğrulama hizmetinden geçersiz yanıt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ungültige Antwort des App-Überprüfungsdienstes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Risposta non valida dal servizio di verifica dell’app."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Invalid response from the app verification service."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 확인 서비스의 응답이 올바르지 않습니다."
          }
        }
      }
    },
    "ai.app-verification-retry": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn’t verify this app right now. Please try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法验证 App，请稍后重试。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pudimos verificar la app en este momento. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous n’avons pas pu vérifier l’app pour le moment. Réessayez."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu uygulamayı şu anda doğrulayamadık. Lütfen tekrar deneyin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese App konnte gerade nicht überprüft werden. Bitte versuche es erneut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile verificare l’app in questo momento. Riprova."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn’t verify this app right now. Please try again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 이 앱을 확인할 수 없습니다. 다시 시도하세요."
          }
        }
      }
    },
    "ai.app-verification-unsupported": {
      "extractionState": "manual",
      "localizations": {
