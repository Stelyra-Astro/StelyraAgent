          "stringUnit": {
            "state": "translated",
            "value": "The account could not be deleted. No local data was removed. Please try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账户删除失败，本机数据未被清除，请重试。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo eliminar la cuenta. No se borraron datos locales. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compte n’a pas pu être supprimé. Aucune donnée locale n’a été effacée. Réessayez."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap silinemedi. Hiçbir yerel veri kaldırılmadı. Lütfen tekrar deneyin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Account konnte nicht gelöscht werden. Es wurden keine lokalen Daten entfernt. Bitte versuche es erneut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
