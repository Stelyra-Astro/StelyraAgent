    "insight.transit.activity-reflects-transiting-houses-activated-natal-planets-and-overlapp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Activity reflects transiting houses, activated natal planets and overlapping exact contacts. It is not a fortune or success score."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "活动度反映行运行星落宫、被触发的本命星体与重叠的精确接触；它不是运气或成功评分。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La actividad refleja las casas transitadas, los planetas natales activados y los contactos exactos superpuestos. No es una puntuación de fortuna ni de éxito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’activité reflète les maisons transitées, les planètes natales activées et les contacts exacts qui se chevauchent. Ce n’est pas un score de chance ou de réussite."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkinlik; transit evlerini, etkinleşen doğum gezegenlerini ve çakışan kesin temasları yansıtır. Bir şans veya başarı puanı değildir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivität spiegelt Transithäuser, aktivierte Radixplaneten und sich überlagernde exakte Kontakte wider. Sie ist kein Glücks- oder Erfolgswert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’attività riflette le case di transito, i pianeti natali attivati e i contatti esatti sovrapposti. Non è un punteggio di fortuna o successo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Activity reflects transiting houses, activated natal planets and overlapping exact contacts. It is not a fortune or success score."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활동도는 트랜짓 하우스, 활성화된 출생 행성, 겹치는 정확 접촉을 반영합니다. 운이나 성공 점수가 아닙니다."
          }
        }
      }
    },
