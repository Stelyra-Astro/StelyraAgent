# Temporary LAN integration configuration used before Provider/Apple secrets are supplied.
# Switch to a complete NODE_ENV=production configuration before any non-LAN exposure.
NODE_ENV=development
PORT=8787
SQLITE_PATH=/data/stelyraagent.sqlite
RUN_TTL_HOURS=24
RUN_SWEEP_INTERVAL_MS=900000
MAX_TOOL_ROUNDS=2
EVIDENCE_TARGET_TOKENS=16000
FINALIZATION_RESERVE_TOKENS=2000
PROVIDER_TIMEOUT_MS=60000
MAX_ANALYSIS_YEARS=100
MAX_LOCATIONS_PER_RUN=2
MAX_AUTONOMOUS_CAPABILITIES=4
MAX_FINAL_CHARACTERS=12000
PROMPT_POLICY_VERSION=3
SCOPE_POLICY_VERSION=1
OUTPUT_POLICY_VERSION=1
SAFETY_POLICY_VERSION=1
DISABLED_CAPABILITIES=

# No live provider is exposed before the user supplies a real key.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL_CATALOG_JSON=[{"id":"standard","label":"Standard","provider":"deepseek","providerModel":"deepseek-chat","creditsRequired":1,"maxInputTokens":32000,"maxOutputTokens":4096,"maxToolRounds":2,"evidenceTargetTokens":16000,"maxProviderCost":0.05,"inputCostPerMillion":1,"outputCostPerMillion":4,"enabled":false,"agentEligible":false}]

# Apple/IAP integration remains explicitly unavailable until real credentials and products exist.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
DATA_ENCRYPTION_KEY=
ADMIN_ORIGIN=http://192.168.0.103:8788
ADMIN_USERNAME=
ADMIN_PASSWORD=
APP_STORE_ENVIRONMENT=Sandbox
APP_STORE_BUNDLE_ID=
APP_STORE_APP_APPLE_ID=
APP_STORE_ENABLE_ONLINE_CHECKS=false
APPLE_ROOT_CA_PATHS=
IAP_PRODUCT_CREDITS_JSON=
