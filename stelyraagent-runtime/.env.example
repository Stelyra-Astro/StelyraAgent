PORT=8787
SQLITE_PATH=/data/stelyraagent.sqlite
RUN_TTL_HOURS=24
RUN_SWEEP_INTERVAL_MS=900000
MAX_TOOL_ROUNDS=2
EVIDENCE_TARGET_TOKENS=16000
FINALIZATION_RESERVE_TOKENS=2000
PROVIDER_TIMEOUT_MS=60000

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Server-owned model allowlist. Clients send only `model_id`; provider model, Credits and budgets come from this policy.
# inputCostPerMillion/outputCostPerMillion are budgeting rates and should be kept in sync with your provider pricing.
# MODEL_CATALOG_JSON=[{"id":"standard","label":"Standard","provider":"deepseek","providerModel":"deepseek-chat","creditsRequired":1,"maxInputTokens":32000,"maxOutputTokens":4096,"maxToolRounds":2,"evidenceTargetTokens":16000,"maxProviderCost":0.05,"inputCostPerMillion":1,"outputCostPerMillion":4,"enabled":true,"agentEligible":true}]
MODEL_CATALOG_JSON=

MAX_ANALYSIS_YEARS=100
MAX_LOCATIONS_PER_RUN=2
MAX_AUTONOMOUS_CAPABILITIES=4
# Emergency server-side kill switch; comma-separated Agent-facing capability IDs.
DISABLED_CAPABILITIES=
MAX_FINAL_CHARACTERS=12000
PROMPT_POLICY_VERSION=3
SCOPE_POLICY_VERSION=1
OUTPUT_POLICY_VERSION=1
SAFETY_POLICY_VERSION=1

APPLE_CLIENT_ID=com.example.stelyraagent
# Generate the Apple client secret outside the container and rotate it normally.
APPLE_CLIENT_SECRET=
# Base64-encoded 32-byte AES key for refresh-token encryption.
DATA_ENCRYPTION_KEY=

ADMIN_ORIGIN=http://localhost:8788
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-random-password

# StoreKit 2 server JWS verification. Credits are server-owned mappings; never trust a client credit amount.
APP_STORE_ENVIRONMENT=Sandbox
APP_STORE_BUNDLE_ID=com.example.stelyraagent
# Required in Production; numeric App Apple ID from App Store Connect.
APP_STORE_APP_APPLE_ID=
APP_STORE_ENABLE_ONLINE_CHECKS=true
# Comma-separated DER certificate files from Apple PKI, mounted read-only into the container.
APPLE_ROOT_CA_PATHS=/run/secrets/apple/AppleRootCA-G2.cer,/run/secrets/apple/AppleRootCA-G3.cer
# Replace product IDs after the new StelyraAgent IAPs are created in App Store Connect.
IAP_PRODUCT_CREDITS_JSON={"com.example.stelyraagent.credits10":10}
